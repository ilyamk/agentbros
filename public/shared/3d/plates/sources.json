{
  "schemaVersion": 1,
  "family": "plates",
  "note": "Own Blender renders used as plates. sha256 is the committed reference render where one exists; a local re-render differs byte for byte. Recipes render with the production settings (scripts/blender/AGENTS.md): frames stay in .cache/assets/plates/<name>/, only the H.264 file is copied to the target (--encode-to), so Remotion bundles do not copy a thousand PNGs; they are slow and need Blender and ffmpeg.",
  "assets": [
    {
      "name": "hero-turntable",
      "target": "public/shared/3d/plates/hero-turntable.mp4",
      "licence": "Own render of phone.glb; inherits the phone model's CC BY 4.0 attribution (public/shared/3d/sources.json)",
      "sha256": "2c6699f62046844c9ecb75060662b80094c11c54e7a60a7e1f880ecbd29ca5f9",
      "size": 203512,
      "source": {
        "kind": "manual",
        "instructions": "Needs 3d:phone and hdri:studio, then about 17 minutes of Cycles: render scripts/blender/hero_turntable.py through scripts/blender-run.ts at 1920x1080, 16 samples, 60 frames, --encode h264 (docs/photoreal-3d.md), and copy the H.264 file to public/shared/3d/plates/hero-turntable.mp4."
      }
    },
    {
      "name": "glossy-orb",
      "target": "public/shared/3d/plates/glossy-orb.mp4",
      "licence": "Own render of an original procedural scene (scripts/blender); no third-party models; lit by a Poly Haven CC0 HDRI (public/shared/hdri/sources.json)",
      "source": {
        "kind": "recipe",
        "command": [
          "pnpm",
          "exec",
          "tsx",
          "scripts/blender-run.ts",
          "--script",
          "scripts/blender/glossy_orb.py",
          "--output",
          ".cache/assets/plates/glossy-orb",
          "--frames",
          "1-96",
          "--samples",
          "64",
          "--resolution",
          "1920x1080",
          "--encode",
          "h264",
          "--encode-to",
          "public/shared/3d/plates/glossy-orb.mp4",
          "--overwrite"
        ],
        "requires": [
          "blender",
          "ffmpeg"
        ],
        "deterministic": false,
        "slow": true
      }
    },

# =============================================================================
#  Agent Bros. Pictures — environment template
# =============================================================================
#
#  cp .env.example .env      then fill in only the keys you need.
#
#  - Nothing here is required: rendering, previews, the studio and the test
#    suite run with an empty .env. `pnpm preflight` lists which keys are set,
#    never their values.
#  - .env is git-ignored. Never commit it and never paste a key into an agent
#    chat: edit .env yourself.
#  - A blank value means "off". Settings with a built-in default are commented
#    out: uncomment them only to change the default, because a blank line
#    overrides the default with an empty string.
#  - Repository CLIs load .env from the current directory (run them from the
#    repository root). Exported variables take precedence over .env. Keys saved in Studio Console
#    override both. AGENTBROS_NO_DOTENV=1 skips both files (tests set it).
#  - A key never authorises spending. Paid jobs need a project budget and
#    admission (docs/paid-execution.md); check with `pnpm budget --project <id>`.
#
#  Legend:  [paid] billed per use on your own account
#           [free] free account or free tier; rate limits noted
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Generation — voice, music, image and video models                [paid]
# -----------------------------------------------------------------------------

# ElevenLabs — voiceover (TTS), music, sound effects, caption alignment and
# transcription: generate:voiceover, generate:music, align:captions, transcribe.
# Key: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# fal.ai — image and video generation, upscaling, background removal
# (FLUX, Kling, MiniMax, ...).
# Key: https://fal.ai/dashboard/keys
FAL_KEY=

# Higgsfield — image and video models (Seedance, Kling, Genjutsu, Soul, ...).
# One value: key ID and secret joined by a colon, exactly as the console shows
# it (<id>:<secret>). Guide: docs/higgsfield.md
# Key: https://open.higgsfield.ai/api-keys
HIGGSFIELD_API_KEY=


# -----------------------------------------------------------------------------
#  2. Stock media — images, video, music and sound effects             [free]
# -----------------------------------------------------------------------------

# Pexels — stock photos and video (200 req/hour, 20,000/month).
# Key: https://www.pexels.com/api/new/
PEXELS_API_KEY=

# Pixabay — stock photos, video (up to 4K) and illustrations (100 req/minute).
# Search results are cached for 24 hours, as Pixabay requires. Stills stop at
# 1280 px unless Pixabay approves full API access for your account.
# Key (log in, it is shown on the page): https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Unsplash — curated high-resolution photos (no video). Register an app at
# https://unsplash.com/documentation#creating-a-developer-account and paste only
# its Access Key here; the Application ID and Secret key are not used.
# Demo apps get 50 requests/hour, apps approved for production 1,000/hour;
# downloading image files does not count. Searches are cached for 6 hours.
UNSPLASH_ACCESS_KEY=

# Freesound — sound effects and ambiences (2,000 req/day).
# Key: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=
# Freesound OAuth2 access token — only for original-quality downloads; previews
# work with FREESOUND_API_KEY alone.
# Docs: https://freesound.org/docs/api/authentication.html
FREESOUND_OAUTH_TOKEN=

# Jamendo — stock music search. The free API tier is non-commercial only.
# Client ID: https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Openverse — openly licensed images and audio. Works anonymously at a lower
# rate limit. For OAuth set either an access token, or the client ID and
# secret together (one without the other is refused).
# Docs: https://docs.openverse.org/api/
OPENVERSE_ACCESS_TOKEN=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
#  3. 3D assets for Blender — blender-arsenal catalogues               [free]
# -----------------------------------------------------------------------------

# Poly Pizza — low-poly CC0 models. Without a key the catalogue is skipped in
# search; download manually and use `--action import`.
# Key: https://poly.pizza (account → API)
POLY_PIZZA_API_KEY=

# Smithsonian Open Access — CC0 3D scans. Without a key the rate-limited
# public DEMO_KEY is used, so it stays commented out until you have one.
# Key: https://api.data.gov/signup/
# SI_API_KEY=


# -----------------------------------------------------------------------------
#  4. Open models — local inference                                    [free]
# -----------------------------------------------------------------------------

# Hugging Face read token for gated open models, cached in ~/.cache/agentbros.
# Used by local speaker diarisation in speech:local
# (pyannote/speaker-diarization-community-1) and by any later gated model.
# Accept each model's conditions on its page first. Sent only to huggingface.co.
# Token ("read"): https://huggingface.co/settings/tokens
HF_TOKEN=


# -----------------------------------------------------------------------------
#  5. Public media acquisition — downloading a reference by link       [paid]
# -----------------------------------------------------------------------------

# Billed per request or per run by the provider; used only when a public
# Instagram, TikTok or YouTube reference cannot be fetched otherwise.
# RapidAPI: https://rapidapi.com/coder2077/api/instagram-downloader-download-instagram-videos-stories1
RAPIDAPI_KEY=
# Apify: https://console.apify.com/account/integrations
APIFY_TOKEN=


# -----------------------------------------------------------------------------
#  6. Local settings — optional overrides, all have defaults
# -----------------------------------------------------------------------------

# Plan paid jobs offline: no budget reservation and no provider submit.
# AGENTBROS_NO_SPEND=1

# uv executable for the Python workers (default: `uv` on PATH).
# Details: docs/python-runtime.md
# AGENTBROS_UV=/opt/homebrew/bin/uv
# Legacy per-tool override for ref:add, ref:analyze and audio:map; it must name
# a uv-compatible executable (not uvx). Prefer AGENTBROS_UV.
# REFERENCE_UVX=

# Model weight caches (default: ~/.cache/agentbros; speech under .../speech).
# AGENTBROS_MODEL_CACHE=
# SPEECH_LOCAL_CACHE=

# Blender binary (default: /Applications/Blender.app/Contents/MacOS/Blender).
# BLENDER_EXECUTABLE=
# Vork binary (default: the repository's installed Vork tool).
# VORK_BIN=


# -----------------------------------------------------------------------------
#  Not configured here
# -----------------------------------------------------------------------------
#
#  No key needed:
#    LottieFiles     public GraphQL API   https://graphql.lottiefiles.com/
#    Pollinations    free AI images       https://image.pollinations.ai/prompt/...
#    Icons and logos Phosphor, Lucide, Tabler, Simple Icons (local packages);
#                    Iconify https://iconify.design/docs/api/ and
#                    SVGL https://svgl.app/docs/api (public APIs).
#                    Profiles and licences: docs/icon-resources.md
#
#  Contributor triage keys are exported in the shell only; triage never loads
#  .env (docs/triage.md):
#    TRIAGE_ANTHROPIC_API_KEY, TRIAGE_OPENAI_API_KEY, TRIAGE_OPENROUTER_API_KEY
#
#  GitHub automation uses GH_TOKEN from the CI environment, not .env.
# =============================================================================

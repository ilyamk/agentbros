{"endpoint_id":"meshy/n1/retexture","metadata":{"category":"3d-to-3d","date":"2026-11-05T17:39:44.741Z","description":"Meshy N1 retexture applies new textures to an existing 3D model using native 3D texturing, producing 2K base color textures from reference images.","display_name":"Meshy N1 Retexture","kind":"inference","license_type":"commercial","model_url":"https://fal.run/meshy/n1/retexture","status":"active","tags":["3d","3d-to-3d","textures","pbr"]},"openapi":{"components":{"schemas":{"File":{"properties":{"content_type":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The mime type of the file.","examples":["image/png"],"title":"Content Type"},"file_name":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The name of the file. It will be auto-generated if not provided.","examples":["z9RV14K95DvU.png"],"title":"File Name"},"file_size":{"anyOf":[{"type":"integer"},{"type":"null"}],"description":"The size of the file in bytes.","examples":[4404019],"title":"File Size"},"url":{"description":"The URL where the file can be downloaded from.","title":"Url","type":"string"}},"required":["url"],"title":"File","type":"object","x-fal-order-properties":["url","content_type","file_name","file_size"]},"MeshyN1RetextureInput":{"description":"Input for Meshy N1 retexturing (2k base color, reference images only).","properties":{"enable_original_uv":{"default":true,"description":"Use the original UV mapping of the model instead of generating new UVs. If the model has no original UV, output quality may be reduced.","title":"Enable Original Uv","type":"boolean"},"enable_safety_checker":{"default":true,"description":"If set to true, input data will be checked for safety before processing.","title":"Enable Safety Checker","type":"boolean"},"image_style_url":{"anyOf":[{"type":"string","ui":{"field":"image"}},{"type":"null"}],"description":"Single reference image, treated as the front view. Required if multiview_image_urls is not provided. Supports .jpg, .jpeg, .png, and .webp formats.","max_file_size":20971520,"max_pixels":178956970,"title":"Image Style Url"},"model_url":{"description":"URL or base64 data URI of a 3D model to texture. Supports .glb, .gltf, .obj, .fbx, .stl formats. Can be a publicly accessible URL or data URI with MIME type application/octet-stream.","examples":["https://v3b.fal.media/files/b/penguin/DId89qXLu6BXu09RFAwAV_model.glb"],"title":"Model Url","type":"string"},"multiview_image_urls":{"anyOf":[{"items":{"_fal_ui_field":"image","type":"string","ui":{"field":"image"}},"maxItems":4,"minItems":1,"type":"array"},{"type":"null"}],"description":"1 to 4 reference views of the target texture (first is the front view, order of the rest is irrelevant). Cannot be combined with image_style_url.","max_file_size":20971520,"max_pixels":178956970,"title":"Multiview Image Urls"}},"required":["model_url"],"title":"RetextureN1Input","type":"object","x-fal-order-properties":["model_url","image_style_url","multiview_image_urls","enable_original_uv","enable_safety_checker"]},"MeshyN1RetextureOutput":{"description":"Output for 3D Model Retexturing","properties":{"image_style_url":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The image URL used for texturing (if provided)","title":"Image Style Url"},"model_glb":{"$ref":"#/components/schemas/File","description":"Retextured 3D object in GLB format.","examples":[{"content_type":"model/gltf-binary","file_name":"model.glb","file_size":4097640,"url":"https://v3b.fal.media/files/b/tiger/pU0TtsRTxXM6VnKEYTHSV_model.glb"}]},"model_urls":{"$ref":"#/components/schemas/ModelUrls","description":"URLs for different 3D model formats","examples":[{"fbx":{"content_type":"application/octet-stream","file_name":"model.fbx","file_size":4713692,"url":"https://v3b.fal.media/files/b/rabbit/agzKf8N8zeVnteg72NiF4_model.fbx"},"glb":{"content_type":"model/gltf-binary","file_name":"model.glb","file_size":4097640,"url":"https://v3b.fal.media/files/b/tiger/pU0TtsRTxXM6VnKEYTHSV_model.glb"}
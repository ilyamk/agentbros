{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": { "config": "", "css": "pulled/globals.css", "baseColor": "neutral", "cssVariables": true, "prefix": "" },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/pulled",
    "utils": "@/pulled/lib/utils",
    "ui": "@/pulled/ui",
    "lib": "@/pulled/lib",
    "hooks": "@/pulled/hooks"
  },
  "registries": {
    "@magicui": "https://magicui.design/r/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@reactbits": "https://reactbits.dev/r/{name}.json",
    "@originui": "https://originui.com/r/{name}.json",
    "@cult-ui": "https://www.cult-ui.com/r/{name}.json",
    "@motion-primitives": "https://motion-primitives.com/c/{name}.json"
  }
}

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Remotion output
out/

# Local verification, agent work logs and archived maintenance runs are never source inputs.
docs/verification/
docs/workstreams/
docs/archive/

# Generated / downloaded assets (keep .gitkeep)
public/projects/*/voiceover/
public/projects/*/music/
public/projects/*/assets/
public/shared/images/
public/shared/music/
public/shared/lottie/
# SFX media is fetched or synthesised; its manifests and indexes are tracked
public/shared/sfx/*
!public/shared/sfx/*/
public/shared/sfx/*/*
!public/shared/sfx/*/manifest.json
!public/shared/sfx/synth/pack.json
!public/shared/sfx/sfx-clap.json
!public/shared/sfx/sfx-index.json
!public/**/.gitkeep

# Shared media comes from pnpm assets:sync; only the manifests are tracked (docs/assets.md)
public/shared/hdri/*
!public/shared/hdri/sources.json
public/shared/3d/*
!public/shared/3d/sources.json
!public/shared/3d/plates/
public/shared/3d/plates/*
!public/shared/3d/plates/sources.json
public/shared/collage/*
!public/shared/collage/sources.json
public/shared/fonts/*
!public/shared/fonts/sources.json
!public/shared/fonts/.gitkeep
public/motion-lab/showcase/*.mp4
/public/motion-lab/*.png

# Media files
*.mp3
*.mp4
*.mov
*.webm

# Build output
/build/
/remotion.config.js
/remotion.config.js.map
/remotion.config.d.ts

# Stray tsc output next to sources
/src/**/*.js
/src/**/*.js.map
/src/**/*.d.ts
/scripts/**/*.js
/scripts/**/*.js.map
/scripts/**/*.d.ts
/tests/**/*.js
/tests/**/*.js.map
/tests/**/*.d.ts
/examples/**/*.js
/examples/**/*.js.map
/examples/**/*.d.ts
/vendor/**/*.js
/vendor/**/*.js.map
/vendor/**/*.d.ts

# Individual video projects: code and scripts in src/projects/{id}; data, media and notes in public/projects/{id}
/public/projects/*
!/public/projects/.gitkeep
/src/projects/

# Reference library: our analyses (JSON and Markdown) are tracked; no frame, image, video or audio of a film is.
# Allow-list: everything under a reference is ignored except .json and .md. To track another kind, add a `!` line
# here for that exact path, with a reason (docs/contributing-references.md). Nothing else is allowed today.
/design-reference/library/*/**
!/design-reference/library/*/**/
!/design-reference/library/*/**/*.json
!/design-reference/library/*/**/*.md
# Media, generated visuals, comparisons and the verbatim speech and screen text (media/speech-text.full.json) stay local
/design-reference/library/*/media/
/design-reference/library/*/visuals/
/design-reference/library/*/compare/
# The inbox drop zone: films and their sidecar notes stay local; only its README is tracked
/design-reference/library/inbox/*
!/design-reference/library/inbox/README.md
# ref:corpus output, rebuilt from the tracked layers
/design-reference/library/_corpus.json
# Private references (ref:add --private) are ignored in .git/info/exclude, never here, so the id is not tracked

# Agent worktrees
/.claude/worktrees/
/public/projects/*/pipeline/reference/*/media/
/public/projects/*/pipeline/reference/*/visuals/
/public/projects/*/pipeline/reference/*/compare/
__pycache__/

# OS, editor and local tool state
.DS_Store
.codegraph/
.venv/
*.pyc
.codex/
.playwright-mcp/
# Harness wiring written by pnpm harness:setup (absolute paths, per machine; docs/harnesses.md)
/.cursor/
/.gemini/
/.opencode/
/.devin/
/.amp/
/.kilo/
/.vscode/mcp.json
/.github/skills
/.github/agents/
/.agents/mcp_config.json
.claude/settings.local.json
# harness:setup --hooks keeps the user's original settings here (RFC 0004 §7.1 H2)
.claude/settings.local.json.agentbros-backup

# A user's local memory: personal to each checkout; only its rules are tracked (memory/AGENTS.md)
/memory/*
!/memory/AGENTS.md

# README visual originals (shipped copies live in docs/readme/)
docs/readme/src/

# Blender arsenal: pinned extensions, asset libraries and bakes live locally (blender-arsenal/AGENTS.md); only manifests are tracked
blender-arsenal/local/

# Private leak patterns for the maintainer
/leak-patterns.local.json

# Local contribution gate evidence
.contrib/

# Owner's local launch checklist
/FIRST_RELEASE_NOTES.md

# Private keys and certificates: never commit
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*

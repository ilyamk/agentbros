      "gates": [
        "pnpm typecheck"
      ],
      "evidence": [
        "Frozen task manifest",
        "Reference run bundle"
      ],
      "ownerReview": false,
      "defaultSize": "S",
      "notWanted": [
        "Uncheckable tasks"
      ]
    },
    {
